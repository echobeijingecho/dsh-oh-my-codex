{
  "name": "dsh-oh-my-codex",
  "version": "0.4.1",
  "description": "Codex App Server execution engine adapter for DSH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/echobeijingecho/dsh-oh-my-codex.git"
  },
  "bugs": {
    "url": "https://github.com/echobeijingecho/dsh-oh-my-codex/issues"
  },
  "homepage": "https://github.com/echobeijingecho/dsh-oh-my-codex#readme",
  "keywords": [
    "dsh",
    "codex",
    "app-server",
    "agent",
    "llm"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "CLAUDE.md.example",
    "cordis.patch.yml.example",
    "cordis.patch.yml",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-plan-mode": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.2"
  },
  "dsh": {
    "engines": {
      "dsh": "0.1.7-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
